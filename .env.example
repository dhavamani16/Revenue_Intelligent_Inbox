# ==========================================
# Revenue Intelligence Inbox — Environment Config
# ==========================================

# Backend Configuration
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite:///./data/revenue_intelligence.db
APP_ENV=production
DEBUG=false

# AI Provider Configuration (Optional)
# If left empty, the application uses its deterministic, rule-based analysis engine
# which guarantees 100% reproducible evidence citations and zero hallucination.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# Frontend Configuration (Used during build / Vite)
VITE_API_BASE_URL=http://localhost:8000/api
